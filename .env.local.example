NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_KIOSK_BRANCH_CODE=

# Server-side only (KHÔNG có tiền tố NEXT_PUBLIC_ — không lộ ra trình duyệt).
# Lấy tại Supabase Dashboard → Settings → API → "service_role" key.
# Dùng cho /api/admin/create-user và /api/admin/delete-user.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
